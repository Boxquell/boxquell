{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Boxquell",
  "version": "0.1.0",
  "identifier": "dev.boxquell.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
